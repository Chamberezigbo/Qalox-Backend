# Firebase
firebase-debug.log
*-firebase.json

# Node version
.nvmrc

# tesseract.js auto-downloads its language data to the cwd on first OCR run
*.traineddata

# KYC identity documents — must never be committed
uploads-private/

# Runtime user uploads (avatars). The folder itself is tracked via .gitkeep so
# the app can write into a fresh checkout, but the uploaded files are user data
# and must not enter git history.
res/uploads/avatars/*
!res/uploads/avatars/.gitkeep
