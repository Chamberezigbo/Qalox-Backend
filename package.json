{
  "name": "ecolex",
  "version": "1.0.0",
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "start": "node dist/app.js",
    "dev": "nodemon -e ts,js,json --watch res --watch app.ts --exec ts-node app.ts",
    "build": "npm run prisma:generate && tsc -p tsconfig.json",
    "build:full": "npm install && npm run prisma:generate && npm run prisma:deploy",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "npx prisma migrate deploy",
    "prisma:migrate": "prisma migrate dev --name",
    "prisma:studio": "prisma studio",
    "prisma:reset": "prisma migrate reset",
    "seed:super-admin": "node scripts/seed-super-admin.js",
    "postinstall": "npx prisma generate"
  },
  "author": "chamberezigbo",
  "license": "ISC",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.2",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "prisma": "^5.22.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1112.0",
    "@aws-sdk/s3-request-presigner": "^3.1112.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^4.21.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "resend": "^6.18.1",
    "sharp": "^0.33.5",
    "tesseract.js": "^7.0.0",
    "winston": "^3.17.0",
    "xlsx": "^0.18.5"
  }
}
