// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model Admin {
  id          Int      @id @default(autoincrement())
  schoolId    Int?
  campusId    Int? // Optional, since admins might not always belong to a campus
  name        String   @db.VarChar(255)
  email       String   @unique @db.VarChar(255) // Ensure unique emails
  password    String   @db.VarChar(255)
  steps       Int      @default(0) // Tracks the steps for the admin
  role        Role
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  hasLoggedIn Boolean  @default(false)

  // Marketer-specific fields (only used when role = marketer)
  tier            String?  @db.VarChar(50)  // bronze, silver, gold, platinum
  referralCode    String?  @unique @db.VarChar(50)
  avatar          String?  @db.VarChar(255)
  phone           String?  @db.VarChar(20)
  address         String?  @db.Text
  city            String?  @db.VarChar(100)
  state           String?  @db.VarChar(100)
  bankName        String?  @db.VarChar(100)
  bankAccountNumber String? @db.VarChar(50)
  bankAccountName String?  @db.VarChar(255)
  isEmailVerified Boolean  @default(false)
  isSuspended     Boolean  @default(false)
  suspendedAt     DateTime?
  // Audit trail for suspension. suspendedBy is the Admin id taken from the
  // verified Bearer token (req.user.id), never from the request body — a
  // service key alone proves "a known app called", not who clicked the button.
  suspensionReason String?  @db.VarChar(500)
  suspendedBy      Int?

  // Marketer settings. notificationPreferences is a JSON blob in Text, matching
  // the `permissions` precedent above. twoFactorEnabled records only whether the
  // marketer has switched 2FA on — the code-verification step is still a stub,
  // so this flag must NOT be treated as a real second factor.
  notificationPreferences String?  @db.Text

  // ---- TOTP two-factor (RFC 6238) ----
  // Secrets are AES-256-GCM encrypted at rest; never stored or returned as
  // plaintext base32 after enrolment.
  twoFactorEnabled          Boolean   @default(false)
  twoFactorSecret           String?   @db.Text // encrypted, active
  twoFactorPendingSecret    String?   @db.Text // encrypted, awaiting verify-setup
  twoFactorPendingExpiresAt DateTime?
  // Last accepted 30s time-step. A code from a step <= this is a replay and is
  // refused, so a valid code cannot be used twice.
  twoFactorLastUsedStep     BigInt?
  // jti of the outstanding login tempToken. Cleared on use, which makes the
  // tempToken single-use rather than merely short-lived.
  twoFactorTempTokenId      String?   @db.VarChar(64)
  // Throttling state for 2FA challenges (verify, verify-setup, disable).
  twoFactorFailedAttempts   Int       @default(0)
  twoFactorLockedUntil      DateTime?

  // KYC verification (marketers). The document itself is stored outside the
  // statically-served uploads folder — see res/uploads-private/kyc — and is
  // only reachable through an authenticated Super Admin route.
  verificationStatus       String?   @default("pending") @db.VarChar(20) // pending | approved | rejected
  verificationDocumentType String?   @db.VarChar(20)  // nin | passport | drivers | voters
  verificationDocumentPath String?   @db.VarChar(255) // relative path on disk, never a public URL
  verificationSubmittedAt  DateTime?
  verificationReviewedAt   DateTime?
  verificationRejectionReason String? @db.Text

  // Password reset (stores a SHA-256 hash of the raw token sent by email, never the raw token itself)
  resetPasswordToken   String?   @db.VarChar(255)
  resetPasswordExpires DateTime?

  // Set at signup when this account was created by redeeming a marketer-issued
  // SchoolToken, so the school created in the later setup step can be
  // attributed back to that marketer (MarketerSchoolLead). Cleared once consumed.
  pendingSchoolTokenId Int?

  // Marketer Commission & Wallet Fields (only for role=marketer)
  commissionRate            Float?   @default(0.0)  // Legacy fallback commission percentage (e.g., 5.0 = 5%)
  newSchoolCommissionRate   Float?   // Per-marketer override used on a new school's first commission payout
  renewalCommissionRate     Float?   // Per-marketer override used on renewals
  commissionStructure       String?  @db.VarChar(50) // 'flat', 'tiered', 'performance'

  // Wallet/Financial Fields
  walletBalance       Float?   @default(0.0)
  walletPending       Float?   @default(0.0)
  totalEarned         Float?   @default(0.0)
  totalWithdrawn       Float?   @default(0.0)

  // Transaction History (JSON array for simplicity, can normalize later)
  transactionCount    Int      @default(0)
  lastPayoutDate      DateTime?

  // Sub-admin fields (only used when role = sub_admin)
  subAdminType     String?  @db.VarChar(50) // hr, secretary, bursar, other
  subAdminLabel    String?  @db.VarChar(100) // custom label when subAdminType = other, e.g. "Exams Officer"
  createdByAdminId Int? // id of the head admin (super_admin/school_admin) who created this sub-admin
  permissions      String?  @db.Text // JSON array of granted permission keys, e.g. ["students.manage","fees.manage"]

  // Relationships
  school                       School?                @relation(fields: [schoolId], references: [id])
  campus                       Campus?                @relation(fields: [campusId], references: [id])
  createdContinuousAssessments ContinuousAssessment[] @relation("AdminCreatedCAs")
  createdExams                 Exam[]                 @relation("AdminCreatedExams")
  createdExamSchedules         ExamSchedule[]         @relation("AdminCreatedExamSchedules")

  publishedResults PublishedResult[]
  commissions      Commission[]
  notifications    Notification[]
  marketerSchoolLeads MarketerSchoolLead[]
  walletTransactions  WalletTransaction[]
  payoutRequests      PayoutRequest[]
  recoveryCodes       TwoFactorRecoveryCode[]
  securityEvents      SecurityEvent[]
  schoolTokens        SchoolToken[]
  marketerDocuments   MarketerDocument[]
  platformCommunications  PlatformCommunication[]
  systemNotifications     SystemNotification[]
  systemNotificationReads SystemNotificationRead[]

  @@map("admins")
}

enum Role {
  super_admin          // legacy: head admin / owner of an individual school (unchanged, live data)
  school_admin         // per-school head admin (now fully functional, equivalent to super_admin for school routes)
  sub_admin            // permission-scoped staff created by a school's head admin (HR, secretary, bursar, other)
  marketer
  platform_super_admin // Qalox platform operator (Super Admin Portal) — distinct from the legacy school-owner "super_admin"
}

model School {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(255) // Add @unique here
  prefix      String   @db.VarChar(10)
  logoUrl     String?  @db.VarChar(255)
  stampUrl    String?  @db.VarChar(255)
  email       String?  @db.VarChar(255)
  phoneNumber String?  @db.VarChar(50)
  address     String?  @db.Text
  isSuspended Boolean  @default(false)
  suspendedAt DateTime?
  suspensionReason String? @db.VarChar(500)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // SMS broadcast quota — per-term allowance, reset when a new AcademicTerm is
  // activated. Set directly by Super Admin for now (defaults to Basic-tier
  // limit of 300). Once schools are formally linked to a BillingPlan, this
  // should be derived from the plan's smsQuotaPerTerm instead of set ad-hoc.
  smsQuotaPerTerm Int @default(300)
  smsUsedThisTerm Int @default(0)

  // Current active billing plan (denormalized convenience alongside
  // SchoolSubscription, which holds the full billing-cycle history).
  billingPlanId Int?
  billingPlan   BillingPlan? @relation(fields: [billingPlanId], references: [id])

  campuses            Campus[]
  admins              Admin[]
  Class               Class[]
  Staff               Staff[]
  Student             Student[]
  Subject             Subject[]
  GradingScheme       GradingScheme[]
  RemarkScheme        RemarkScheme?
  AcademicSession     AcademicSession[]
  AcademicTerm        AcademicTerm[]
  CATemplate          CATemplate[]
  feeStructures       FeeStructure[]
  studentFees         StudentFee[]
  broadcasts          Broadcast[]
  subscriptions       SchoolSubscription[]
  payments            SchoolPayment[]
  marketerLead        MarketerSchoolLead?
  loginEvents         LoginEvent[]
  commissions         Commission[]
  examSchedules       ExamSchedule[]
  assignments         Assignment[]

  @@index([billingPlanId])
  @@map("schools")
}

model Token {
  id         Int       @id @default(autoincrement())
  email      String    @unique @db.VarChar(255) // Unique key to ensure no duplicate email tokens
  uniqueKey  String    @unique @db.VarChar(255) // Unique key for token generation/validation
  status     String?   @db.VarChar(50)
  schoolName String    @db.VarChar(255) // School name associated with the token
  createdAt  DateTime  @default(now()) // Timestamp for when the token was created
  expiresAt  DateTime? // Registration token expiry (Super Admin Portal tokens)
  usedAt     DateTime? // When the token was consumed to register an admin
  usedBy     Int?      // ID of the Admin created from this token

  @@map("tokens") // Maps to a table named `tokens`
}

model Campus {
  id            Int      @id @default(autoincrement())
  schoolId      Int
  name          String   @db.VarChar(255)
  address       String?  @db.Text
  phoneNumber   String?  @db.VarChar(50)
  email         String?  @db.VarChar(255)
  revenueTarget Float? // optional, admin-set monthly revenue target for analytics
  createdAt     DateTime @default(now())

  school             School              @relation(fields: [schoolId], references: [id])
  admins             Admin[]
  Class              Class[]
  Staff              Staff[]
  Student            Student[]
  Subject            Subject[]
  TeacherAssignments TeacherAssignment[] // ✅ added
  gradingSchemes GradingScheme[]
  examSchedules  ExamSchedule[]

  @@unique([schoolId, name]) // 🔒 Prevent same campus name for same school
  @@map("campuses")
}

model Class {
  id          Int          @id @default(autoincrement())
  schoolId    Int
  campusId    Int?
  name        String
  customName  String?
  department  String?      @db.VarChar(100) // e.g. Sciences, Arts, Commercial, Social Sciences — optional, admin-set
  staffId     Int? // Optional, in case a class is created without a teacher assigned
  createdAt   DateTime     @default(now())
  school      School       @relation(fields: [schoolId], references: [id])
  campus      Campus?      @relation(fields: [campusId], references: [id])
  staff       Staff?       @relation(fields: [staffId], references: [id])
  classGroups ClassGroup[] // One-to-many relation with ClassGroup
  students    Student[] // One-to-many relation with Student

  assignments TeacherAssignment[] // Teachers teaching in this class

  ContinuousAssessment ContinuousAssessment[]
  Exam                 Exam[]
  GradingSchemeClass   GradingSchemeClass[]
  CATemplate           CATemplate[]
  ClassSubject         ClassSubject[]
  publishedResults PublishedResult[]
  resultSubmissions ResultSubmission[]
  feeStructures FeeStructure[]
  attendance    Attendance[]
  examScheduleEntries ExamScheduleEntry[]
  postedAssignments   Assignment[]

  // Optionally, add a unique constraint for name, school, and campus
  @@unique([name, schoolId, campusId])
  @@map("classes") // Maps the model to the "classes" table in the database
}

model ClassGroup {
  id        Int      @id @default(autoincrement())
  classId   Int
  name      String
  createdAt DateTime @default(now())
  class     Class    @relation(fields: [classId], references: [id])

  students Student[] // ✅ back-relation (one group -> many students)
}

model Staff {
  id                 Int       @id @default(autoincrement())
  schoolId           Int
  campusId           Int?
  name               String
  email              String?   @unique
  gender             String?   // "Male", "Female", "Other"
  phoneNumber        String?
  address            String?
  duty               String? // e.g., "Teacher", "Accountant", "Cleaner"
  nextOfKin          String?
  dateEmployed       DateTime?
  payroll            Decimal? // salary or payroll reference
  createdAt          DateTime  @default(now())
  registrationNumber String    @unique @db.VarChar(50)

  school      School              @relation(fields: [schoolId], references: [id])
  campus      Campus?             @relation(fields: [campusId], references: [id])
  classes     Class[] // if staff is a teacher, they can have classes
  assignments TeacherAssignment[] // All class+subject+campus teaching assignments
  resultSubmissions ResultSubmission[]
  markedAttendance Attendance[]
  postedAssignments Assignment[]

  @@unique([schoolId, registrationNumber])
  @@map("staffs")
}

model Student {
  id       Int  @id @default(autoincrement())
  schoolId Int
  campusId Int?
  classId  Int

  name              String
  surname           String
  otherNames        String
  gender            String? @db.VarChar(10)
  dateOfBirth       String?
  guardianName      String?
  guardianNumber    String?
  guardianEmail     String?
  lifestyle         String?
  academicSessionId Int
  email             String?
  classGroupId      Int? // ✅ optional since not all students must have a group
  parentId          Int? // linked once a parent account claims this child via /api/parent/link-child

  academicSession    AcademicSession @relation(fields: [academicSessionId], references: [id])
  classGroup         ClassGroup?     @relation(fields: [classGroupId], references: [id])
  // ✅ NEW: Registration Number Field
  registrationNumber String          @unique @db.VarChar(50)
  passportUrl       String?  @db.VarChar(255)

  createdAt  DateTime     @default(now())
  school     School       @relation(fields: [schoolId], references: [id])
  campus     Campus?      @relation(fields: [campusId], references: [id])
  class      Class        @relation(fields: [classId], references: [id])
  parent     Parent?      @relation(fields: [parentId], references: [id])
  CAResult   CAResult[]
  ExamResult ExamResult[]
  publishedResultRows PublishedResultRow[]
  studentFees StudentFee[]
  attendance  Attendance[]
  parentAlerts ParentAlert[]

  // ✅ NEW: Unique constraint for registration number per school
  @@unique([schoolId, registrationNumber])
  @@index([parentId])
  @@map("students")
}

model Parent {
  id        Int      @id @default(autoincrement())
  email     String   @unique @db.VarChar(255)
  password  String
  phone     String?  @db.VarChar(50)
  name      String   @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  children Student[]
  alerts   ParentAlert[]

  @@map("parents")
}

model ParentAlert {
  id        Int      @id @default(autoincrement())
  parentId  Int
  studentId Int
  type      String   @db.VarChar(20) // absence, low_grade, fee_reminder, general
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([parentId])
  @@index([studentId])
  @@map("parent_alerts")
}

model Subject {
  id        Int      @id @default(autoincrement())
  schoolId  Int
  campusId  Int?
  name      String   @db.VarChar(255) // Subject name (e.g., "Mathematics")
  code      String?  @db.VarChar(50) // Unique subject code (optional)
  createdAt DateTime @default(now())

  school                School                 @relation(fields: [schoolId], references: [id])
  campus                Campus?                @relation(fields: [campusId], references: [id])
  assignments           TeacherAssignment[] // Who teaches this subject (and where)
  continuousAssessments ContinuousAssessment[]
  exams                 Exam[]
  classSubjects         ClassSubject[]
  publishedResults PublishedResult[]
  resultSubmissions ResultSubmission[]
  examScheduleEntries ExamScheduleEntry[]
  postedAssignments Assignment[]

  @@map("subjects")
}

model TeacherAssignment {
  id         Int      @id @default(autoincrement())
  staffId    Int
  classId    Int? // Optional classId
  subjectId  Int? // Optional subjectId
  campusId   Int? // Optional campusId
  assignedAt DateTime @default(now())

  staff   Staff    @relation(fields: [staffId], references: [id])
  class   Class?   @relation(fields: [classId], references: [id])
  subject Subject? @relation(fields: [subjectId], references: [id])
  campus  Campus?  @relation(fields: [campusId], references: [id])

  @@index([staffId, classId, subjectId, campusId], name: "TeacherAssignment_unique") // Unique index
  @@map("teacher_assignments")
}

// A homework/task a teacher posts to one class+subject, visible to every
// student in that class. Create/update is gated by a matching
// TeacherAssignment row (staffId+classId+subjectId) so a teacher can only
// post to a class/subject they actually teach.
model Assignment {
  id          Int      @id @default(autoincrement())
  schoolId    Int
  classId     Int
  subjectId   Int
  staffId     Int // creating teacher
  title       String   @db.VarChar(255)
  description String?  @db.Text
  dueDate     DateTime @db.Date
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school  School  @relation(fields: [schoolId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  staff   Staff   @relation(fields: [staffId], references: [id])

  @@index([schoolId])
  @@index([classId])
  @@index([staffId])
  @@map("assignments")
}

model Attendance {
  id             Int      @id @default(autoincrement())
  studentId      Int
  classId        Int
  date           DateTime @db.Date
  status         String   @db.VarChar(10) // present, absent, late
  markedByStaffId Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student      Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class        Class   @relation(fields: [classId], references: [id])
  markedByStaff Staff  @relation(fields: [markedByStaffId], references: [id])

  @@unique([studentId, date])
  @@index([classId, date])
  @@map("attendance")
}

// School-level default CA structure
model CATemplate {
  id       Int     @id @default(autoincrement())
  schoolId Int
  classId  Int?    // NULL = applies to whole school, set = class override
  name     String  // e.g. "CA1", "CA2", "Exam"
  maxScore Int
  isExam   Boolean @default(false) // true = this is an exam, false = CA

  school School  @relation(fields: [schoolId], references: [id])
  class  Class?  @relation(fields: [classId], references: [id])

  @@unique([schoolId, classId, name])
  @@map("ca_templates")
}

// Direct link between class and subject
model ClassSubject {
  id        Int @id @default(autoincrement())
  classId   Int
  subjectId Int

  class   Class   @relation(fields: [classId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([classId, subjectId])
  @@map("class_subjects")
}


model ContinuousAssessment {
  id        Int      @id @default(autoincrement())
  classId   Int
  subjectId Int?
  name      String   @db.VarChar(50)
  maxScore  Int
  createdAt DateTime @default(now())

  createdByAdminId Int?
  createdByAdmin   Admin? @relation("AdminCreatedCAs", fields: [createdByAdminId], references: [id])

  class     Class      @relation(fields: [classId], references: [id])
  subject   Subject?   @relation(fields: [subjectId], references: [id])
  caResults CAResult[]

  @@unique([classId, subjectId, name])
  @@map("continuous_assessments")
}

model CAResult {
  id                Int      @id @default(autoincrement())
  studentId         Int?
  caId              Int
  academicSessionId Int
  termId            Int?     // ← add this
  score             Decimal
  createdAt         DateTime @default(now())

  student         Student?             @relation(fields: [studentId], references: [id])
  ca              ContinuousAssessment @relation(fields: [caId], references: [id])
  academicSession AcademicSession      @relation(fields: [academicSessionId], references: [id])
  term            AcademicTerm?        @relation(fields: [termId], references: [id]) // ← add this

  @@unique([studentId, caId, academicSessionId])
  @@map("ca_results")
}


model Exam {
  id        Int      @id @default(autoincrement())
  classId   Int
  subjectId Int?
  name      String   @db.VarChar(50) // e.g., "Midterm", "Final"
  weightage Decimal? // Weightage in the final grade
  maxScore  Int
  createdAt DateTime @default(now())

  createdByAdminId Int?
  createdByAdmin   Admin? @relation("AdminCreatedExams", fields: [createdByAdminId], references: [id])

  class       Class        @relation(fields: [classId], references: [id])
  subject     Subject?     @relation(fields: [subjectId], references: [id])
  examResults ExamResult[]
  scheduledDate DateTime?
  scheduleEntries ExamScheduleEntry[]

  @@unique([classId, subjectId, name])
  @@map("exams")
}

enum ExamScheduleStatus {
  draft
  published
}

enum ExamSchedulingMethod {
  same_schedule
  default_with_overrides
  auto
  fully_custom
}

// A timetabled exam "sitting" (e.g. "First Term Examination 2025/2026")
// spanning many classes/subjects with campus/session/date/time/duration.
// Deliberately separate from `Exam`, which is a per-class-subject grading
// line item (weightage/maxScore) auto-generated from CA templates — see
// AssessmentService.assignSubjectsToClass. Publishing an ExamSchedule does a
// best-effort backfill onto matching Exam rows (see ExamScheduleService);
// it never creates new, incomplete Exam rows.
model ExamSchedule {
  id                Int      @id @default(autoincrement())
  schoolId          Int
  campusId          Int
  academicSessionId Int
  examType          String   @db.VarChar(80)
  name              String   @db.VarChar(120)
  description       String?  @db.VarChar(300)
  schedulingMethod  ExamSchedulingMethod
  status            ExamScheduleStatus @default(draft)
  createdByAdminId  Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  publishedAt       DateTime?

  school          School          @relation(fields: [schoolId], references: [id])
  campus          Campus          @relation(fields: [campusId], references: [id])
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id])
  createdByAdmin  Admin?          @relation("AdminCreatedExamSchedules", fields: [createdByAdminId], references: [id])
  entries         ExamScheduleEntry[]

  @@index([schoolId])
  @@index([campusId])
  @@index([academicSessionId])
  @@map("exam_schedules")
}

model ExamScheduleEntry {
  id              Int      @id @default(autoincrement())
  examScheduleId  Int
  classId         Int
  subjectId       Int
  date            DateTime @db.Date
  startTime       String   @db.VarChar(5) // "09:00"
  durationMinutes Int
  linkedExamId    Int?     // best-effort backfill target, set on publish
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  examSchedule ExamSchedule @relation(fields: [examScheduleId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id])
  subject      Subject      @relation(fields: [subjectId], references: [id])
  linkedExam   Exam?        @relation(fields: [linkedExamId], references: [id])

  @@unique([examScheduleId, classId, subjectId])
  @@index([classId])
  @@index([subjectId])
  @@map("exam_schedule_entries")
}

model ExamResult {
  id                Int      @id @default(autoincrement())
  studentId         Int?
  examId            Int
  academicSessionId Int
  termId            Int?     // ← add this
  score             Decimal
  createdAt         DateTime @default(now())

  student         Student?        @relation(fields: [studentId], references: [id])
  exam            Exam            @relation(fields: [examId], references: [id])
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id])
  term            AcademicTerm?   @relation(fields: [termId], references: [id]) // ← add this

  @@unique([studentId, examId, academicSessionId])
  @@map("exam_results")
}

model GradingScheme {
  id          Int      @id @default(autoincrement())
  schoolId    Int
  name        String // e.g. "Junior Secondary Grading"
  usePosition Boolean  @default(true) // rank students or not
  createdAt   DateTime @default(now())
  campusId    Int?  

  school  School               @relation(fields: [schoolId], references: [id])
  grades  GradingRule[]
  campus  Campus?              @relation(fields: [campusId], references: [id]) 
  classes GradingSchemeClass[]

  @@map("grading_schemes")
}

model GradingRule {
  id       Int    @id @default(autoincrement())
  schemeId Int
  minScore Int
  maxScore Int
  grade    String
  remark   String

  scheme GradingScheme @relation(fields: [schemeId], references: [id])

  @@map("grading_rules")
}

model GradingSchemeClass {
  id       Int @id @default(autoincrement())
  schemeId Int
  classId  Int @unique

  scheme GradingScheme @relation(fields: [schemeId], references: [id])
  class  Class         @relation(fields: [classId], references: [id])
}

model RemarkScheme {
  id        Int      @id @default(autoincrement())
  schoolId  Int
  name      String
  createdAt DateTime @default(now())

  school School      @relation(fields: [schoolId], references: [id])
  rules  RemarkRule[]

  @@unique([schoolId])
  @@map("remark_schemes")
}

model RemarkRule {
  id       Int    @id @default(autoincrement())
  schemeId Int
  minScore Int
  maxScore Int
  remark   String @db.Text

  scheme RemarkScheme @relation(fields: [schemeId], references: [id])

  @@map("remark_rules")
}

model AcademicSession {
  id        Int      @id @default(autoincrement())
  schoolId  Int
  name      String
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  school            School             @relation(fields: [schoolId], references: [id])
  students          Student[]
  caResults         CAResult[]
  examResults       ExamResult[]
  publishedResults  PublishedResult[]
  resultSubmissions ResultSubmission[]
  terms             AcademicTerm[]
  examSchedules     ExamSchedule[]

  @@unique([schoolId, name])
  @@map("academic_sessions")
}

model PublishedResult {
  id                 Int      @id @default(autoincrement())
  classId            Int
  subjectId          Int
  academicSessionId  Int
  termId             Int?
  publishedByAdminId Int
  publishedAt        DateTime @default(now())

  class           Class           @relation(fields: [classId], references: [id])
  subject         Subject         @relation(fields: [subjectId], references: [id])
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id])
  term            AcademicTerm?   @relation(fields: [termId], references: [id])
  admin           Admin           @relation(fields: [publishedByAdminId], references: [id])
  rows            PublishedResultRow[]

  @@unique([classId, subjectId, academicSessionId])
  @@map("published_results")
}

model PublishedResultRow {
  id                Int     @id @default(autoincrement())
  publishedResultId Int
  studentId         Int
  caTotal           Float
  examTotal         Float
  total             Float
  grade             String?
  remark            String?
  position          Int?

  publishedResult PublishedResult @relation(fields: [publishedResultId], references: [id])
  student         Student         @relation(fields: [studentId], references: [id])

  @@map("published_result_rows")
}


enum SubmissionStatus {
  PENDING    // submitted, awaiting admin review
  REJECTED   // admin rejected, teacher can re-enter
}

model ResultSubmission {
  id                Int              @id @default(autoincrement())
  classId           Int
  subjectId         Int
  academicSessionId Int
  termId            Int?             // ← add this
  staffId           Int
  status            SubmissionStatus @default(PENDING)
  submittedAt       DateTime         @default(now())

  class           Class           @relation(fields: [classId], references: [id])
  subject         Subject         @relation(fields: [subjectId], references: [id])
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id])
  term            AcademicTerm?   @relation(fields: [termId], references: [id]) // ← add this
  staff           Staff           @relation(fields: [staffId], references: [id])

  @@unique([classId, subjectId, academicSessionId, staffId])
  @@map("result_submissions")
}


model AcademicTerm {
  id              Int       @id @default(autoincrement())
  schoolId        Int
  sessionId       Int
  name            String    // "First Term", "Second Term", "Third Term"
  isActive        Boolean   @default(false)
  resumptionDate  DateTime? // Date when this term resumes (next term start date)
  createdAt       DateTime  @default(now())

  school   School          @relation(fields: [schoolId], references: [id])
  session  AcademicSession @relation(fields: [sessionId], references: [id])

  caResults         CAResult[]
  examResults       ExamResult[]
  resultSubmissions ResultSubmission[]
  publishedResults  PublishedResult[]

  @@unique([schoolId, sessionId, name])
  @@map("academic_terms")
}

// SchoolToken - Assessment/Registration tokens for schools
// Used by Marketer Portal to generate access codes for schools
model SchoolToken {
  id          Int      @id @default(autoincrement())
  marketerId  Int
  code        String   @unique @db.VarChar(50) // e.g., "TKN-1721472000000"
  schoolName  String   @db.VarChar(255)
  schoolEmail String   @db.VarChar(255)
  status      String   @default("active") @db.VarChar(50) // active, used, revoked, expired
  issuedDate  DateTime @default(now())
  expiryDate  DateTime // Token expiration date
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  marketer Admin @relation(fields: [marketerId], references: [id], onDelete: Cascade)

  @@index([marketerId])
  @@index([status])
  @@index([schoolName])
  @@index([expiryDate])
  @@map("school_tokens")
}

// Commission - Marketer commission records
// Tracks earnings from token sales and school registrations
model Commission {
  id          Int      @id @default(autoincrement())
  marketerId  Int      // Admin with role=marketer
  schoolId    Int?     // The school whose payment generated this commission (null for older rows predating this field)
  amount      Float    @default(0.0)
  rate        Float    @default(0.0) // Commission rate (e.g., 5.0 = 5%)
  status      String   @default("pending") @db.VarChar(50) // pending, paid, rejected
  month       Int      // Month (1-12)
  year        Int      // Year (e.g., 2026)
  source      String   @db.VarChar(100) // "Token Sale", "School Registration", etc.
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  marketer Admin   @relation(fields: [marketerId], references: [id], onDelete: Cascade)
  school   School? @relation(fields: [schoolId], references: [id])

  @@index([marketerId])
  @@index([schoolId])
  @@index([year, month])
  @@index([status])
  @@map("commissions")
}

// Notification - Messages for marketers
// Alerts about commissions, tokens, account status, etc.
model Notification {
  id          Int      @id @default(autoincrement())
  marketerId  Int      // Admin with role=marketer
  title       String   @db.VarChar(255)
  message     String   @db.Text
  type        String   @db.VarChar(50) // info, success, warning, error
  isRead      Boolean  @default(false)
  link        String?  @db.VarChar(255) // URL to navigate to (e.g., "/commissions")
  relatedId   Int?     // ID of related resource (commission ID, token ID, etc.)
  relatedType String?  @db.VarChar(50) // commission, token, account, etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  marketer Admin @relation(fields: [marketerId], references: [id], onDelete: Cascade)

  @@index([marketerId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// Platform-wide Settings
model PlatformSettings {
  id                    Int      @id @default(autoincrement())
  commissionRate        Float    @default(5.0) // Default 5% (legacy — see firstPaymentCommissionRate/renewalCommissionRate)
  firstPaymentCommissionRate Float @default(40.0) // % a marketer earns on a school's first payment
  renewalCommissionRate      Float @default(5.0)  // % a marketer earns on every subsequent renewal
  platformName          String   @default("Qalox") @db.VarChar(255)
  supportEmail          String   @default("support@qalox.com") @db.VarChar(255)
  maxTokensPerSchool    Int      @default(10)
  tokenExpirationDays   Int      @default(30)
  updatedAt             DateTime @updatedAt

  @@map("platform_settings")
}

// Billing Plans
model BillingPlan {
  id            Int      @id @default(autoincrement())
  name          String   @unique @db.VarChar(255)
  description   String?  @db.Text
  monthlyPrice  Float    @default(0.0) // billed "per term" in the UI — internal name unchanged to avoid touching the live Flutterwave/webhook code
  annualPrice   Float    @default(0.0) // billed "per session" in the UI
  features      String   @db.Text // JSON array stored as text
  minStudents   Int      @default(0)
  maxStudents   Int?     // null = unlimited (Premium)
  maxSubAdmins  Int?     // null = unlimited (Premium)
  isActive      Boolean  @default(true)
  highlighted   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  schools       School[]
  subscriptions SchoolSubscription[]

  @@index([isActive])
  @@index([name])
  @@map("billing_plans")
}

model SchoolSubscription {
  id               Int       @id @default(autoincrement())
  schoolId         Int
  billingPlanId    Int
  billingCycle     String    @db.VarChar(20) // monthly, annual
  status           String    @default("active") @db.VarChar(20) // active, cancelled, past_due, trialing
  startedAt        DateTime  @default(now())
  nextBillingDate  DateTime?
  flwCustomerId       String? @db.VarChar(100) // Flutterwave customer id (cus_...), reused across renewals
  flwPaymentMethodId  String? @db.VarChar(100) // Flutterwave payment_method id (pmd_...), reused across renewals
  trialEndsAt          DateTime? // set when status = "trial"; lazily checked, no cron
  trialGrantedByAdminId Int?     // Super Admin who started the trial, for audit
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  school      School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  billingPlan BillingPlan   @relation(fields: [billingPlanId], references: [id])
  payments    SchoolPayment[]

  @@index([schoolId])
  @@index([billingPlanId])
  @@index([status])
  @@map("school_subscriptions")
}

model SchoolPayment {
  id             Int       @id @default(autoincrement())
  schoolId       Int
  subscriptionId Int?
  amount         Float
  flwReference   String    @unique @db.VarChar(100) // our reference, sent as `reference` to Flutterwave
  flwChargeId    String?   @db.VarChar(100) // Flutterwave's charge id (chg_...), for reconciliation
  status         String    @default("pending") @db.VarChar(20) // pending, success, failed
  isFirstPayment Boolean   @default(false)
  paidAt         DateTime?
  createdAt      DateTime  @default(now())

  school       School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subscription SchoolSubscription? @relation(fields: [subscriptionId], references: [id])

  @@index([schoolId])
  @@index([subscriptionId])
  @@map("school_payments")
}

// ============================================
// FEE MANAGEMENT
// ============================================

// A fee breakdown configured for one class, for one term/session.
// Creating one auto-generates a StudentFee invoice for every student
// currently enrolled in that class.
model FeeStructure {
  id        Int      @id @default(autoincrement())
  schoolId  Int
  classId   Int
  term      String   @db.VarChar(100)
  session   String   @db.VarChar(50)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school      School             @relation(fields: [schoolId], references: [id])
  class       Class              @relation(fields: [classId], references: [id])
  items       FeeStructureItem[]
  studentFees StudentFee[]

  @@unique([classId, term, session])
  @@index([schoolId])
  @@map("fee_structures")
}

model FeeStructureItem {
  id             Int      @id @default(autoincrement())
  feeStructureId Int
  name           String   @db.VarChar(255)
  amount         Float
  createdAt      DateTime @default(now())

  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)

  @@index([feeStructureId])
  @@map("fee_structure_items")
}

// Per-student invoice for a given FeeStructure. `totalFee` is a snapshot
// taken at creation time so later fee-structure edits don't retroactively
// change what a student already owes for a term.
model StudentFee {
  id             Int      @id @default(autoincrement())
  schoolId       Int
  studentId      Int
  feeStructureId Int
  totalFee       Float
  amountPaid     Float    @default(0.0)
  status         String   @default("unpaid") @db.VarChar(20) // unpaid, partial, paid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school       School       @relation(fields: [schoolId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id])
  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id])
  payments     Payment[]

  @@unique([studentId, feeStructureId])
  @@index([schoolId])
  @@index([status])
  @@map("student_fees")
}

// A single payment transaction against a StudentFee. Also the source
// record for receipt generation (one payment = one receipt).
model Payment {
  id            Int      @id @default(autoincrement())
  studentFeeId  Int
  amount        Float
  paymentMethod String   @db.VarChar(50) // Bank Transfer, Cash, Card
  paymentDate   DateTime @default(now())
  receiptNo     String   @unique @db.VarChar(50)
  recordedBy    Int? // Admin.id who recorded this payment
  createdAt     DateTime @default(now())

  studentFee StudentFee @relation(fields: [studentFeeId], references: [id])

  @@index([studentFeeId])
  @@map("payments")
}

// ============================================
// NOTICES / BROADCAST
// ============================================

// A single notice/announcement. Always visible in-app (once the relevant
// portal exists); optionally also blasted out as SMS at send time.
model Broadcast {
  id              Int      @id @default(autoincrement())
  schoolId        Int
  title           String   @db.VarChar(255)
  message         String   @db.Text
  category        String   @db.VarChar(20) // fee, pta, event, general
  recipientType   String   @db.VarChar(20) // all, parents, teachers, students
  smsEnabled      Boolean  @default(false)
  totalRecipients Int      @default(0)
  smsSentCount    Int      @default(0)
  createdByAdminId Int?
  createdAt       DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@map("broadcasts")
}

// ============================================
// MARKETER SCHOOL LEADS
// ============================================

// A school a marketer is tracking/onboarding — NOT the same as the real
// School tenant table (which has campuses, classes, prefix, etc). A marketer
// manages a list of these as their own CRM; a lead becoming a real, live
// School tenant happens separately via the Token-based onboarding flow.
model MarketerSchoolLead {
  id                 Int      @id @default(autoincrement())
  marketerId         Int
  schoolId           Int?     @unique // set once this lead converts into a real, paying School
  name               String   @db.VarChar(255)
  email              String   @db.VarChar(255)
  location           String?  @db.VarChar(255)
  state              String?  @db.VarChar(100)
  registrationNumber String?  @db.VarChar(100)
  type               String?  @db.VarChar(20) // Private, Public
  contactPerson      String?  @db.VarChar(255)
  phone              String?  @db.VarChar(50)
  tokensIssued       Int      @default(0)
  totalRevenue       Float    @default(0.0)
  totalCommission    Float    @default(0.0)
  status             String   @default("active") @db.VarChar(20) // active, inactive
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  marketer Admin   @relation(fields: [marketerId], references: [id], onDelete: Cascade)
  school   School? @relation(fields: [schoolId], references: [id])

  @@index([marketerId])
  @@map("marketer_school_leads")
}

/// A marketer's uploaded identity document, one row per upload.
///
/// Supersedes the single-document `verification*` columns on Admin, which are
/// still written in parallel so the Marketer Portal's existing profile view
/// keeps working. Admin mirrors the LATEST document; this table is the record.
///
/// `path` is a filename inside res/uploads-private/kyc — NOT a public URL.
/// These files are deliberately outside res/uploads (which app.ts serves
/// statically with no auth), so a government ID scan is never fetchable by URL
/// alone. Reads go through GET /marketers/:id/documents/:documentId/file,
/// which is Super Admin-gated.
model MarketerDocument {
  id              Int       @id @default(autoincrement())
  marketerId      Int
  type            String    @db.VarChar(30) // id_card | passport | utility_bill | cac | other
  path            String    @db.VarChar(255)
  status          String    @default("pending") @db.VarChar(20) // pending | approved | rejected
  rejectionReason String?   @db.Text
  reviewedAt      DateTime?
  reviewedBy      Int? // Admin id of the reviewing super admin, from the Bearer token
  uploadedAt      DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  marketer Admin @relation(fields: [marketerId], references: [id], onDelete: Cascade)

  @@index([marketerId])
  // Serves the pending-verification queue: filter by status, newest first.
  @@index([status, uploadedAt])
  @@map("marketer_documents")
}

// ============================================
// MARKETER WALLET TRANSACTIONS
// ============================================

// One row per wallet operation (credit/debit/payout), created by
// updateMarketerWallet. balanceAfter is a snapshot at the time of the
// transaction, used to render the wallet's balance-history chart without a
// separate query.
/// Single-use 2FA recovery codes. Stored as bcrypt hashes only — the plaintext
/// is shown to the user exactly once, in the verify-setup response.
model TwoFactorRecoveryCode {
  id       Int       @id @default(autoincrement())
  adminId  Int
  codeHash String    @db.VarChar(255)
  usedAt   DateTime?

  createdAt DateTime @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("two_factor_recovery_codes")
}

/// Security-relevant account events (2FA enabled/disabled, recovery codes
/// regenerated or consumed). Append-only; nothing in the app updates a row.
model SecurityEvent {
  id        Int      @id @default(autoincrement())
  adminId   Int
  event     String   @db.VarChar(64)
  detail    String?  @db.VarChar(255)
  ipAddress String?  @db.VarChar(64)
  userAgent String?  @db.Text
  createdAt DateTime @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([event])
  @@map("security_events")
}

/// A marketer-initiated withdrawal request awaiting Super Admin action.
/// WalletTransaction records money that has ALREADY moved and has no status
/// field, so it cannot represent "pending approval" — hence a separate model.
/// Funds are NOT reserved when a request is raised; the balance is re-checked
/// at approval time, and only one pending request per marketer is allowed.
model PayoutRequest {
  id         Int      @id @default(autoincrement())
  marketerId Int
  amount     Float
  status     String   @default("pending") @db.VarChar(20) // pending | approved | rejected

  // Snapshot of the destination account as it was when the request was raised,
  // so a later bank-details change cannot silently redirect an approved payout.
  bankName          String? @db.VarChar(100)
  bankAccountNumber String? @db.VarChar(50)
  bankAccountName   String? @db.VarChar(255)

  note              String?   @db.VarChar(255)
  rejectionReason   String?   @db.Text
  reviewedByAdminId Int?
  reviewedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  marketer Admin @relation(fields: [marketerId], references: [id], onDelete: Cascade)

  @@index([marketerId])
  @@index([status])
  @@map("payout_requests")
}

model WalletTransaction {
  id            Int      @id @default(autoincrement())
  marketerId    Int
  type          String   @db.VarChar(20) // credit, debit, payout
  amount        Float
  description   String?  @db.VarChar(255)
  balanceAfter  Float
  // Super Admin who performed the operation, from the verified Bearer token.
  // Nullable: rows predating this column, and service-key-only calls that
  // carry no user identity, legitimately have no actor.
  performedByAdminId Int?
  createdAt     DateTime @default(now())

  marketer Admin @relation(fields: [marketerId], references: [id], onDelete: Cascade)

  @@index([marketerId])
  @@map("wallet_transactions")
}

// ============================================
// SUPER ADMIN: COMMUNICATIONS / NOTIFICATIONS / ANALYTICS
// ============================================

// A platform-wide message to school admins. recipientCount/status are
// computed at creation time from real School/Admin data; actual dispatch
// (email/SMS provider) is not yet wired up, so status reflects that rather
// than claiming a send that didn't happen.
model PlatformCommunication {
  id              Int      @id @default(autoincrement())
  type            String   @db.VarChar(10) // email, sms
  subject         String?  @db.VarChar(255)
  message         String   @db.Text
  recipientTarget String   @db.VarChar(50) // all_schools, specific_schools
  targetSchoolIds String?  @db.Text // JSON array of School ids, when recipientTarget = specific_schools
  recipientCount  Int      @default(0)
  status          String   @default("pending") @db.VarChar(20) // pending, sent, failed, partial
  createdByAdminId Int
  sentAt          DateTime?
  createdAt       DateTime @default(now())

  createdByAdmin Admin @relation(fields: [createdByAdminId], references: [id])

  @@index([createdByAdminId])
  @@map("platform_communications")
}

// A platform-wide in-app notification to school admins. One row fans out to
// many recipients; SystemNotificationRead tracks per-admin read state.
model SystemNotification {
  id              Int       @id @default(autoincrement())
  type            String    @db.VarChar(20) // maintenance, announcement, token_expiry, security, update
  title           String    @db.VarChar(255)
  message         String    @db.Text
  recipientTarget String    @db.VarChar(50) // all_schools, specific_schools
  targetSchoolIds String?   @db.Text // JSON array of School ids, when recipientTarget = specific_schools
  recipientCount  Int       @default(0)
  scheduledAt     DateTime?
  sentAt          DateTime?
  createdByAdminId Int
  createdAt       DateTime  @default(now())

  createdByAdmin Admin @relation(fields: [createdByAdminId], references: [id])
  reads          SystemNotificationRead[]

  @@index([createdByAdminId])
  @@map("system_notifications")
}

model SystemNotificationRead {
  id             Int      @id @default(autoincrement())
  notificationId Int
  adminId        Int
  readAt         DateTime @default(now())

  notification SystemNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  admin        Admin               @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([notificationId, adminId])
  @@map("system_notification_reads")
}

// One row per successful login, across all actor types. Written going
// forward only — there is no historical login data to backfill, so
// analytics built on this will only reflect activity from the day it ships.
model LoginEvent {
  id        Int      @id @default(autoincrement())
  actorType String   @db.VarChar(20) // admin, marketer, teacher, student, parent
  actorId   Int
  schoolId  Int?
  ip        String?  @db.VarChar(64)
  userAgent String?  @db.VarChar(255)
  createdAt DateTime @default(now())

  school School? @relation(fields: [schoolId], references: [id])

  @@index([actorType, actorId])
  @@index([schoolId])
  @@index([createdAt])
  @@map("login_events")
}

// One bulk-import upload. Persisted (not in-memory) so a completed job stays
// readable long after extraction finishes — admins fix rows for a while before
// confirming, and the job must survive a server restart in between.
model BulkImportJob {
  id       String @id @db.VarChar(64) // "imp_<random>" — echoed to the client as importId
  schoolId Int
  adminId  Int
  entity   String @db.VarChar(16) // "students" | "staff"

  // Lifecycle the client polls: processing -> completed | failed
  status       String  @default("processing") @db.VarChar(16)
  progress     Int     @default(0) // 0-100, only meaningful while processing
  stage        String  @default("Queued") @db.VarChar(64) // human label shown under the progress bar
  errorMessage String? @db.Text // set on failure — shown to the admin verbatim

  fileName      String  @db.VarChar(255)
  fileSize      Int     @default(0)
  mimeType      String  @default("") @db.VarChar(128)
  allowWarnings Boolean @default(true) // false would make warnings block the import too

  columnsJson String? @db.LongText // column definitions the client renders its grid from
  summaryJson String? @db.LongText // cached counts; recomputed on every row edit

  completedAt DateTime? // when extraction+validation finished
  confirmedAt DateTime? // when the admin committed the import (blocks a second commit)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  records BulkImportRecord[]

  @@index([schoolId])
  @@index([adminId])
  @@index([status])
  @@map("bulk_import_jobs")
}

// One extracted row. Kept as its own table rather than a JSON blob on the job so
// a PATCH of a single row is a targeted update instead of a read-modify-write of
// the whole set (which would lose edits when two rows are fixed at once).
model BulkImportRecord {
  id        Int    @id @default(autoincrement())
  jobId     String @db.VarChar(64)
  recordId  String @db.VarChar(32) // "row_2" — the client's stable handle for this row
  rowNumber Int // 1-based line number in the source file

  dataJson     String  @db.LongText // flat { [columnKey]: string } map
  isValid      Boolean @default(false) // mirrors errors.length === 0
  isDuplicate  Boolean @default(false)
  errorsJson   String  @db.LongText // [{ field, message }] — blocks the import
  warningsJson String  @db.LongText // [{ field, message }] — never blocks

  // Warnings raised while READING the file (e.g. "09/04/2012 was read
  // day-first"), which validation cannot rederive later because it only ever
  // sees the already-normalised value. Kept separately so revalidating a row
  // re-attaches them instead of silently dropping them, and cleared per field
  // once the admin edits that field themselves.
  sourceWarningsJson String? @db.LongText

  importedAt    DateTime? // set once the row is actually created in the DB
  failureReason String?   @db.Text // why this row failed at confirm time

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job BulkImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, recordId])
  @@index([jobId, rowNumber])
  @@map("bulk_import_records")
}

// Shared notification feed for Admin/Teacher/Student dashboards. Parent has
// its own separate ParentAlert model (already live, untouched by this one).
model UserNotification {
  id            Int      @id @default(autoincrement())
  recipientType String   @db.VarChar(20) // admin, teacher, student
  recipientId   Int      // Admin.id, Staff.id, or Student.id depending on recipientType
  schoolId      Int
  title         String   @db.VarChar(255)
  message       String   @db.Text
  type          String   @db.VarChar(30) // fee_payment, new_student, notice, result_published, general
  link          String?  @db.VarChar(255)
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([recipientType, recipientId])
  @@index([isRead])
  @@map("user_notifications")
}
